+##########################################################################\r
+#  戦う操縦士\r
+# 1933年におけるフランス労働評議会の構成が左派勢力によって占められることが明らかになると、\r
+# フランス共和国における新たな省庁として空軍省が設立される動きが表れた。\r
+# 第一次世界大戦で登場し、これからの戦争を決定せしむると思われる航空機という兵器について、\r
+# 陸軍や海軍とも違う三つ目の軍隊としての定義が行われるのは自然な流れであった。\r
+# そのフランス空軍省の初代長官となったのは、第一次世界大戦末期の2年間で12機の撃墜を果たし、\r
+# エースパイロットとしての地位を確固たるものとし、\r
+# 文学者としても著名なアントワーヌ・ド・サン＝テグジュペリ氏となった。\r
+###########################################################################\r
+\r
+event = { \r
+	id = 3327060\r
+	random = no\r
+	country = FRA\r
+\r
+	trigger = {\r
+	event = 3327008 # 労働総取引所選挙 ― 極左が優位\r
+	event = 3327010 # 労働総取引所選挙 ― 穏健派が優位\r
+	event = 3327011 # 労働総取引所選挙 ― 優位勢力が生まれなかった\r
+	NOT = { atwar = FRA }\r
+	random = 12\r
+	}\r
+\r
+	name = "EVT_3327060_NAME"\r
+	desc = "EVT_3327060_DESC"\r
+	style = 2\r
+	picture = "SaintExupery"\r
+\r
+	date = { day = 0 month = 1 year = 1934 }\r
+	offset = 18\r
+	deathdate = { day = 29 month = 11 year = 1936 }\r
+\r
+	action = { # やれるようにしていくよりしようのないものだ\r
+	name = "ACTIONNAME3327060A"\r
+	command = { type = dissent value = -0.5 }\r
+	command = { type = domestic which = freedom value = 1 }\r
+	command = { type = wakeminister which = 5834 }\r
+	command = { type = wakeleader which = 5804 }\r
+	command = { type = waketeam which = 5102 }\r
+	command = { type = chiefofair which = 5834 }\r
+	}\r
+}\r
